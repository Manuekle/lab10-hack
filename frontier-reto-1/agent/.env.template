# Copiar a .env (ignorado por git) y completar. Plantilla publicable sin secretos.

# --- Servicio (producción y local) ---
# Token del equipo exigido en Authorization: Bearer <token> por las tres rutas.
TEAM_TOKEN=
OPENROUTER_API_KEY=
# Modelo elegido con `npm run benchmark` (10/10): ver output/audit/benchmark-modelos.md.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Respaldo si el principal falla por red, timeout o proveedor. Mismas coordenadas en píxeles.
OPENROUTER_FALLBACK_MODEL=anthropic/claude-haiku-5.5
# pixel para Claude/GPT; norm1000 para Gemini/Qwen.
OPENROUTER_COORDS=pixel
PORT=8080
# En Railway apuntar al volumen, p. ej. /data/agent.db
DATABASE_PATH=./.data/agent.db

# --- Límites (valores iniciales del diseño; ajustar con mediciones) ---
TASK_REVOKE_MS=270000
TASK_HARD_STOP_MS=280000
INFERENCE_TIMEOUT_MS=20000
INFERENCE_ATTEMPTS=2
MAX_PROPOSALS=40
MAX_ACTIVE_TASKS=2

# --- Práctica (sólo harness y scripts; el servicio no la lee) ---
PRACTICE_DESKTOP_URL=wss://<escritorio>/websockify
PRACTICE_DESKTOP_PASSWORD=
# Token de /__reset y /__check del escritorio de práctica.
PRACTICE_DESKTOP_TOKEN=

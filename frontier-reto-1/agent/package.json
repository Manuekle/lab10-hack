{
  "name": "frontier-reto1-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente visual que opera aplicaciones sin API por VNC (Frontier BOG/26, Reto 1).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"test/*.test.ts\"",
    "capture": "node --env-file-if-exists=.env scripts/capture.ts",
    "benchmark": "node --env-file-if-exists=.env scripts/benchmark.ts",
    "walk": "node --env-file-if-exists=.env scripts/walk.ts",
    "check-env": "node --env-file-if-exists=.env scripts/check-env.ts",
    "test:local-desktop": "node scripts/local-desktop.ts",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=.env src/main.ts",
    "task": "node --env-file-if-exists=.env scripts/run-task.ts",
    "practice": "node --env-file-if-exists=.env scripts/practice.ts",
    "canary": "node --env-file-if-exists=.env scripts/canary.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
